@@ -0,0 +1,35 @@
+# Uploaded files (truck photos, documents) get a fresh random filename on
+# every upload — see ajax/trucks_handler.php and ajax/document_handler.php —
+# so a URL never changes contents. Safe to cache for a long time.
+<IfModule mod_expires.c>
+  ExpiresActive On
+  ExpiresByType image/png        "access plus 1 year"
+  ExpiresByType image/jpeg       "access plus 1 year"
+  ExpiresByType image/webp       "access plus 1 year"
+  ExpiresByType application/pdf  "access plus 1 year"
+</IfModule>
+
+<IfModule mod_headers.c>
+  Header set Cache-Control "public, max-age=31536000, immutable"
+</IfModule>
+
+# ── Hardening: never execute anything in this directory ─────────────────────
+# Upload handlers derive the stored file's extension from its validated MIME
+# type, never from the attacker-supplied original filename, so a script
+# shouldn't be able to land here with an executable extension in the first
+# place. This is deliberate defense-in-depth on top of that — a second layer
+# in case of any future upload-path bug, misconfigured handler, or a file
+# that reaches this folder some other way.
+<IfModule mod_php.c>
+  php_flag engine off
+</IfModule>
+<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi|sh|asp|aspx)$">
+  <IfModule mod_authz_core.c>
+    Require all denied
+  </IfModule>
+  <IfModule !mod_authz_core.c>
+    Order allow,deny
+    Deny from all
+  </IfModule>
+</FilesMatch>
+Options -ExecCGI -Indexes
