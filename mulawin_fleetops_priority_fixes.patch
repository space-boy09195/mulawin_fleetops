+          showToast(res.message || 'Purchase order created.', 'success');
+          AjaxRegion.refreshOrReload('po-table');
+        } else {
+          showAlert(createPoAlert, res.message ?? 'Failed to create purchase order.');
+        }
+      })
+      .catch(() => {
+        setBusy(submitCreatePoBtn, poBtnSpinner, false);
+        showAlert(createPoAlert, 'Network error. Please try again.');
+      });
+  });
+
+  // Mark Ordered / Receive / Cancel — delegated so it also works after an
+  // AjaxRegion refresh swaps in fresh buttons.
+  document.querySelector('#pane-po')?.addEventListener('click', (e) => {
+    const btn = e.target.closest('.btn-pts-mark-ordered, .btn-pts-receive-po, .btn-pts-cancel-po');
+    if (!btn) return;
+
+    const poId = btn.dataset.poId;
+    const action = btn.classList.contains('btn-pts-mark-ordered') ? 'mark_po_ordered'
+                 : btn.classList.contains('btn-pts-receive-po')   ? 'receive_po'
+                 : 'cancel_po';
+
+    if (action === 'cancel_po' && !window.confirm('Cancel this purchase order?')) return;
+
+    btn.disabled = true;
+
+    postAjax({ action, po_id: poId })
+      .then(res => {
+        if (res.success) {
+          showToast(res.message || 'Updated.', 'success');
+          AjaxRegion.refresh('po-table').then(() => {
+            // Receiving changes stock levels too, so refresh that region as well
+            if (action === 'receive_po') AjaxRegion.refresh('stock-table');
+          });
+        } else {
+          btn.disabled = false;
+          showToast(res.message ?? 'Action failed.', 'danger');
+        }
+      })
+      .catch(() => {
+        btn.disabled = false;
+        showToast('Network error. Please try again.', 'danger');
+      });
+  });
+
 })();
